{
  "name": "grip-figma-bridge",
  "version": "0.5.2",
  "description": "Bridge between the Grip Figma plugin and MCP agents — install with: npx grip-figma-bridge install",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "scripts"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js dist/install.js",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "node test/scope.mjs",
    "test:win": "node test/win-smoke.mjs"
  },
  "bin": {
    "grip-figma": "dist/index.js",
    "grip-figma-bridge": "dist/install.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "uuid": "^9.0.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.12",
    "typescript": "^5.5.0"
  }
}
