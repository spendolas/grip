# Dependencies and tool caches
node_modules/
.npm-cache/
.DS_Store

# Generated by `npm run build` (local) and by CI (release). Never committed:
# the release bundles are built ONLY in CI from source and published as
# release assets. Keep the locations: a local build writes them here so that
# `node bridge/install.mjs` and importing figma-plugin/manifest.json from a
# clone keep working after `npm run build`.
/bridge/
/figma-plugin/code.js
src/bridge/dist/
/dist/

# Local tooling state
.claude/settings.local.json
.claude/worktrees/
.remember/
